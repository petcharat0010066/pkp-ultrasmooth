<%- include('../partials/header') %>
<div class="row-between" style="margin-bottom:14px;">
  <h1>จัดการสินค้า (Admin)</h1>
  <div>
    <a class="btn" href="/admin/products/new">+ เพิ่มสินค้า</a>
    <a class="btn btn-soft" href="/admin/orders">ดูคำสั่งซื้อ (<%= ordersCount %>)</a>
  </div>
</div>
<table>
  <thead><tr><th>สินค้า</th><th>หมวด</th><th>ราคา</th><th>สต็อก</th><th>จัดการ</th></tr></thead>
  <tbody>
    <% products.forEach(p => { %>
      <tr>
        <td><%= p.name %></td>
        <td><%= p.category %></td>
        <td>฿<%= p.price %></td>
        <td><%= p.stock %></td>
        <td>
          <a class="btn btn-soft" href="/admin/products/<%= p.id %>/edit">แก้ไข</a>
          <form method="post" action="/admin/products/<%= p.id %>/delete" style="display:inline;" onsubmit="return confirm('ยืนยันลบ?')">
            <button class="btn-danger">ลบ</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
<%- include('../partials/footer') %>
